{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fountain_inline",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "inline_note"
          },
          {
            "type": "SYMBOL",
            "name": "inline_boneyard"
          },
          {
            "type": "SYMBOL",
            "name": "paren_text"
          },
          {
            "type": "SYMBOL",
            "name": "text"
          }
        ]
      }
    },
    "paren_text": {
      "type": "PATTERN",
      "value": "（[^）\\n]+）|\\([^)\\n]+\\)"
    },
    "inline_note": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\[\\[[^\\]]*(?:\\][^\\]]*)*\\]\\]"
      }
    },
    "inline_boneyard": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\/\\*[^*]*(?:\\*[^\\/][^*]*)*\\*\\/"
      }
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\[\\(\\/\\n（）]+|\\/|\\n|."
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}