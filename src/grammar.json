{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fountain_inline",
  "rules": {
    "document": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_element"
      }
    },
    "_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "boneyard"
        },
        {
          "type": "SYMBOL",
          "name": "inline_note"
        },
        {
          "type": "SYMBOL",
          "name": "paren_text"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "boneyard": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "boneyard_start"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^*]+"
              },
              {
                "type": "PATTERN",
                "value": "\\*[^\\/]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "*/"
        }
      ]
    },
    "inline_note": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "note_start"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\\]]+"
              },
              {
                "type": "PATTERN",
                "value": "\\][^\\]]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]]"
        }
      ]
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\/\\[]"
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "paren_text"
    },
    {
      "type": "SYMBOL",
      "name": "boneyard_start"
    },
    {
      "type": "SYMBOL",
      "name": "note_start"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}